# {{ ansible_managed }}
# Configuration de Hermes Agent (Nous Research) pour le lab Purple Team.
# Régénérée à chaque passage d'Ansible : une modification à la main sera écrasée.
{{ hermes_config_version.stdout | default('') }}

model:
  # Profil « {{ hermes_llm_profile }} » (hermes_llm_profiles dans host_vars/agent.yml)
  provider: {{ hermes_agent_provider }}
  base_url: "{{ hermes_agent_base_url }}"
  default: "{{ hermes_agent_model }}"
  context_length: {{ hermes_agent_context }}
  # Aucune clé ici : une clé éventuelle est dans ~/.hermes/.env (venue du vault).

# Tâches secondaires (compression, titres) : le même LLM que le profil choisi
auxiliary:
  compression:
    provider: main
  title_generation:
    provider: main

approvals:
  mode: {{ hermes_agent_approvals }}            # manual | smart | off
  timeout: {{ hermes_agent_approval_timeout }}  # sans réponse : commande refusée
  deny:
{% for motif in hermes_agent_deny_patterns %}
    - "{{ motif }}"
{% endfor %}

terminal:
  backend: local                        # commandes exécutées en tant que {{ hermes_agent_user }}
  cwd: "{{ hermes_agent_home }}"

platform_toolsets:
  cli: [{{ hermes_agent_toolsets | join(', ') }}]

telemetry:
  shared_metrics:
    enabled: false
    send: false

updates:
  check: false                          # le lab est isolé d'Internet
